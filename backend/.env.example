# ---------------------------------------------------------------------------
# ap-recon-service configuration
#
# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. Every variable below is one the code actually
# reads (checked by grepping src/ before writing this file, not guessed).
# ---------------------------------------------------------------------------

# --- Core ---
PORT=3001
# The frontend's dev server origin (Vite default). Update if you serve the
# built frontend from somewhere else.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# When running via docker-compose.yml, "db" is the service name and this
# value is already correct. Running Postgres yourself instead? Point this at
# it — e.g. postgresql://postgres:localdev@localhost:5432/ap_recon
DATABASE_URL=postgresql://postgres:localdev@db:5432/ap_recon
DB_POOL_MAX=10
LOG_SQL=false

# --- Auth ---
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_MAX=300

# --- File storage ---
# Local disk path for uploaded invoice files. In docker-compose.yml this is
# a mounted volume so files survive a container restart.
FILE_STORAGE_ROOT=/app/storage/invoices

# --- LLM extraction ---
# 'gemini' or 'azure_openai'. The app runs fine with NEITHER configured —
# uploads still work, they just stay in a permanently-"pending extraction"
# state until you set one of these up. See the README for where to get
# each of these credentials.
LLM_PROVIDER=gemini

# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for the current
# cost-appropriate "flash" tier model name before relying on this default.
GEMINI_MODEL=gemini-2.5-flash

# Only needed if LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# true = use @azure/identity / managed identity instead of the API key above
# (recommended in production; leave false for local testing)
AZURE_OPENAI_USE_MANAGED_IDENTITY=false

# --- D365 Finance & Operations (Acme Stores subsidiary) ---
# From your Entra ID (Azure AD) app registration.
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
# e.g. https://your-org.operations.dynamics.com — no trailing slash
D365_ENVIRONMENT_URL=

# --- Odoo (Acme Fresh subsidiary) ---
# The Odoo.sh branch URL this should point at — confirm production vs a
# staging branch before pointing this at real data.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
# Generate under Settings > Users > (that user) > Account Security. Odoo 17+
# rejects raw-password XML-RPC auth by default — this must be an API key.
ODOO_API_KEY=

# --- Standalone PO comparison ---
# How long a cached Purchase Order (purchase_orders table) is trusted
# before the next invoice referencing it triggers a refetch from the real
# ERP. Never retroactively changes an already-matched invoice's stored
# verdict. A reviewer can always force an immediate
# refresh for one specific invoice via POST /api/invoices/:id/refresh-po,
# regardless of this setting.
PO_REFRESH_TTL_HOURS=24
